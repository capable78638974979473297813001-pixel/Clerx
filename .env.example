# Copy to .env and fill in. All values are optional — Clerx runs without them,
# and each one just upgrades the experience. Restart the server after editing.

# Encrypts provider tokens at rest. Set to any long random string in production.
CLERX_SECRET=

# Answer engine. With a key, Clerx reads each employee's cleared documents and
# writes the answer in your company's voice (semantic — understands paraphrases).
# Without one, it falls back to the built-in keyword engine and still works.
# The standard ANTHROPIC_API_KEY env var is also picked up automatically.
CLERX_ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-4-8. Set to claude-haiku-4-5 or
# claude-sonnet-5 to trade some answer quality for lower per-question cost.
CLERX_LLM_MODEL=

# Public base URL of the app. Must match the redirect URL registered in your
# Slack/Notion apps: <CLERX_BASE_URL>/api/sources/oauth/<provider>/callback
# Dev default is http://localhost:5175
CLERX_BASE_URL=http://localhost:5175

# One-click "Connect Slack". Create ONE app at api.slack.com/apps:
#  - OAuth & Permissions → Redirect URLs: <CLERX_BASE_URL>/api/sources/oauth/slack/callback
#  - Bot Token Scopes: channels:read, channels:history, channels:join
#  - Activate Public Distribution (lets any workspace install it)
CLERX_SLACK_CLIENT_ID=
CLERX_SLACK_CLIENT_SECRET=

# One-click "Connect Notion". Create a public integration at
# notion.so/my-integrations (type: Public):
#  - Redirect URI: <CLERX_BASE_URL>/api/sources/oauth/notion/callback
CLERX_NOTION_CLIENT_ID=
CLERX_NOTION_CLIENT_SECRET=

# API port for the backend (default 3001). The Vite dev server proxies /api here.
API_PORT=3001
